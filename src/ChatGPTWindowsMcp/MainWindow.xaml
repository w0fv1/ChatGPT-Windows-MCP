<Window x:Class="ChatGPTWindowsMcp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Windows MCP"
        Width="920" Height="690"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- 主页面 -->
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,22,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="840" HorizontalAlignment="Stretch">
                    <TextBlock Text="ChatGPT Windows MCP" Style="{StaticResource TitleText}"/>
                    <TextBlock Margin="0,10,0,28"
                               MaxWidth="900"
                               FontSize="16"
                               LineHeight="25"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Windows-MCP + OpenAI Secure MCP Tunnel 的便携启动器。配置并启动本机服务后，在 ChatGPT 中创建插件，即可接入这台电脑。"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="720">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="StatusTitleText" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MainStartupPercentText" Margin="14,0,0,0" FontSize="25" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetailText"
                                       Margin="0,10,0,24"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="PrimaryButton"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="PrimaryButton_Click"/>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="OpenChatGptButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Visibility="Collapsed"
                                        Content="打开 ChatGPT"
                                        Click="OpenChatGptButton_Click"/>
                                <Button x:Name="ReconfigureButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource AccentBrush}"
                                        Padding="8,6"
                                        Visibility="Collapsed"
                                        Content="重新配置"
                                        Click="ReconfigureButton_Click"/>
                                <Button x:Name="PluginSetupButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                        Visibility="Collapsed" Content="配置插件" Click="PluginSetupButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="AdvancedExpander" Margin="0,24,0,0" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="高级选项" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="10,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="通常无需修改"/>
                            </StackPanel>
                        </Expander.Header>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="连接凭据" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Margin="0,6,0,24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="可在这里直接修改 OpenAI Tunnel ID 和 Runtime API Key。保存后将在下次连接时生效。"/>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Tunnel ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AdvancedTunnelIdTextBox"/>
                                    <TextBlock Text="应以 tunnel_ 开头。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,26">
                                    <TextBlock Text="Runtime API Key" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="AdvancedApiKeyPasswordBox"/>
                                    <TextBlock Text="密钥仅保存在本机 config.json 中。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,22,0,0" Margin="0,0,0,22">
                                    <TextBlock Text="运行设置" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <TextBlock Margin="0,6,0,24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="这些参数用于本地 Windows-MCP 和 OpenAI Tunnel 的启动过程。默认值适用于大多数用户。"/>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="MCP 本地端口" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PortTextBox"/>
                                    <TextBlock Text="默认 8000。仅在端口冲突或自定义本地 MCP 时修改。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Tunnel Profile" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProfileTextBox"/>
                                    <TextBlock Text="默认 windows-mcp。作为 tunnel-client 的本地配置名称。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Windows-MCP 包" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WindowsMcpTextBox"/>
                                    <TextBlock Text="默认 windows-mcp，也可以填写固定版本。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Python 版本" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PythonTextBox"/>
                                    <TextBlock Text="默认 3.13，由 uv/uvx 提供运行环境。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,26">
                                    <TextBlock Text="网络代理" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProxyTextBox"/>
                                    <TextBlock Text="用于下载 tunnel-client、安装/运行 uv 和连接 Tunnel。必须以 http:// 或 https:// 开头；留空时可自动检测。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" FontSize="18"/>
                                        <CheckBox x:Name="AutoDetectProxyCheckBox" Margin="0,16,0,10" Content="自动读取 Windows 系统代理供下载和 OpenAI Tunnel 使用"/>
                                        <CheckBox x:Name="ReuseMcpCheckBox" Margin="0,0,0,10" Content="本地端口已有 MCP 时复用"/>
                                        <CheckBox x:Name="AutoDownloadTunnelCheckBox" Margin="0,0,0,0" Content="缺少 tunnel-client 时自动下载官方最新版"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,26,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,10" Content="保存高级选项" Click="SaveAdvancedButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="连接诊断" Click="DoctorButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="打开日志目录" Click="OpenLogsButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="打开 config.json" Click="OpenConfigButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" Content="ChatGPT 连接设置" Click="OpenConnectorButton_Click"/>
                                </WrapPanel>

                                <Border Margin="0,16,0,0" Padding="16" Background="#FFF8E8" CornerRadius="0">
                                    <TextBlock Foreground="#79520A" TextWrapping="Wrap"
                                               Text="安全说明：Windows-MCP 以完整工具模式运行。Runtime API Key 会保存在本机 config.json 中，请勿提交或分享真实配置。"/>
                                </Border>

                                <TextBlock Margin="0,28,0,10" Text="运行日志" Style="{StaticResource SectionTitle}" FontSize="18"/>
                                <TextBox x:Name="LogTextBox"
                                         Height="220"
                                         Padding="12"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="12.5"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 四步配置向导 -->
        <Grid x:Name="WizardRoot" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,22,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Text="创建 MCP 链接" Style="{StaticResource TitleText}"/>

                        <TextBlock x:Name="WizardStepCaption" Margin="0,12,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <WrapPanel Margin="0,0,0,20">
                            <Border Margin="0,0,10,6" Padding="12,6" Background="#EAF2FF"><TextBlock x:Name="TunnelStepPill" Text="1  Tunnel ID" FontWeight="SemiBold"/></Border>
                            <Border Margin="0,0,10,6" Padding="12,6" Background="#ECEEF1"><TextBlock x:Name="ApiStepPill" Text="2  API Key" FontWeight="SemiBold"/></Border>
                            <Border Margin="0,0,10,6" Padding="12,6" Background="#ECEEF1"><TextBlock x:Name="ProxyStepPill" Text="3  网络代理" FontWeight="SemiBold"/></Border>
                            <Border Margin="0,0,0,6" Padding="12,6" Background="#ECEEF1"><TextBlock x:Name="PluginStepPill" Text="4  ChatGPT 插件" FontWeight="SemiBold"/></Border>
                        </WrapPanel>

                        <Border Style="{StaticResource CardStyle}" Padding="32">
                            <Grid>
                                <Grid x:Name="TunnelStepPanel">
                                    <StackPanel>
                                        <TextBlock Text="创建 Tunnel" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <TextBlock Margin="0,10,0,22" FontSize="15" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="先创建一个 OpenAI Tunnel，然后把生成的 Tunnel ID 粘贴到下面。"/>
                                        <WrapPanel>
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="打开 Tunnel 创建页面" Click="WizardOpenTunnel_Click"/>
                                            <Button Margin="0,0,0,10" Style="{StaticResource SecondaryButton}" Content="复制链接" Click="WizardCopyTunnel_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TunnelLinkFeedbackText" Style="{StaticResource HelpText}"/>

                                        <TextBlock Margin="0,28,0,8" Text="Tunnel ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TunnelIdTextBox" TextChanged="TunnelIdTextBox_TextChanged"/>
                                        <TextBlock x:Name="TunnelValidationText" Style="{StaticResource HelpText}"/>

                                        <Grid Margin="0,28,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="取消" Click="WizardCancel_Click"/>
                                            <Button x:Name="TunnelNextButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="下一步" Click="TunnelNextButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ApiStepPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="创建 Runtime API Key" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <TextBlock Margin="0,10,0,22" FontSize="15" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="创建一个 Runtime API Key，用于让这台电脑连接到刚才配置的 OpenAI Tunnel。"/>
                                        <WrapPanel>
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="打开 API Key 创建页面" Click="WizardOpenApiKey_Click"/>
                                            <Button Margin="0,0,0,10" Style="{StaticResource SecondaryButton}" Content="复制链接" Click="WizardCopyApiKey_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ApiKeyLinkFeedbackText" Style="{StaticResource HelpText}"/>

                                        <TextBlock Margin="0,28,0,8" Text="Runtime API Key" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ApiKeyPasswordBox" PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>
                                            <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed" TextChanged="ApiKeyTextBox_TextChanged"/>
                                            <CheckBox x:Name="ShowApiKeyCheckBox" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Content="显示密钥" Checked="ShowApiKeyCheckBox_Changed" Unchecked="ShowApiKeyCheckBox_Changed"/>
                                        </Grid>
                                        <TextBlock x:Name="ApiValidationText" Style="{StaticResource HelpText}"/>

                                        <Grid Margin="0,28,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Content="取消" Click="WizardCancel_Click"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="上一步" Click="WizardBack_Click"/>
                                            <Button x:Name="ApiFinishButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="下一步" Click="ApiFinishButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ProxyStepPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="设置网络代理（可选）" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <TextBlock Margin="0,10,0,22" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Text="先设置下载和连接使用的代理，下一页再配置 ChatGPT 插件。无需代理时留空即可。"/>
                                        <TextBlock Text="代理地址" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="WizardProxyTextBox" TextChanged="WizardProxyTextBox_TextChanged"/>
                                        <TextBlock x:Name="WizardProxyValidationText" Style="{StaticResource HelpText}"/>
                                        <CheckBox x:Name="WizardAutoDetectProxyCheckBox" Margin="0,18,0,0" Content="留空时自动读取 Windows 系统代理"/>
                                        <WrapPanel Margin="0,28,0,0">
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="取消" Click="WizardCancel_Click"/>
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="上一步" Click="ProxyBackButton_Click"/>
                                            <Button x:Name="ProxyNextButton" Margin="0,0,0,10" Style="{StaticResource PrimaryButton}" Content="下一步：配置插件" Click="ProxyNextButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="PluginStepPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="创建 ChatGPT 插件" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <Grid Margin="0,10,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PluginServiceStatusText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="PluginStartupPercentText" Grid.Column="1" Margin="14,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Text="插件名字" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="PluginNameTextBox" MaxLength="80" TextChanged="PluginSettings_TextChanged"/>
                                        <TextBlock x:Name="PluginNameValidationText" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="方式一：手动创建" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="RegisterTunnelButton" Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="创建 MCP 应用" Click="RegisterTunnelButton_Click"/>
                                            <Button Margin="0,0,0,10" Style="{StaticResource SecondaryButton}" Content="复制 Tunnel ID" Click="CopyPluginTunnelIdButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="PluginTunnelIdText" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="等待上方提示 Tunnel 就绪后，打开插件页：添加 → 创建 MCP 应用。连接选“隧道”，粘贴 Tunnel ID；身份验证选“无需身份验证”，确认后创建。使用期间保持启动器运行。" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="方式二：让 AI 创建" Margin="0,18,0,8" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="复制提示词发给 ChatGPT，并选择 @Plugin Creator。已有 MCP 应用时可在下方填入详情链接，方便 AI 复用。" Style="{StaticResource HelpText}"/>
                                        <TextBlock Text="已有 MCP 应用详情链接（可选）" Margin="0,10,0,8" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="PluginConnectionLinkTextBox" TextChanged="PluginSettings_TextChanged"/>
                                        <TextBlock x:Name="PluginConnectionValidationText" Style="{StaticResource HelpText}"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button x:Name="CopyPluginPromptButton" Margin="0,0,12,10" Style="{StaticResource PrimaryButton}" Content="复制创建提示词" Click="CopyPluginPromptButton_Click"/>
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="打开 ChatGPT" Click="OpenChatGptButton_Click"/>
                                            <Button x:Name="CopyChatGptLinkButton" Margin="0,0,0,10" Style="{StaticResource SecondaryButton}" Content="复制 ChatGPT 链接" Click="CopyChatGptLinkButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="PluginPromptCopyFeedbackText">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="取消" Click="WizardCancel_Click"/>
                                            <Button x:Name="PluginBackButton" Margin="0,0,12,10" Style="{StaticResource SecondaryButton}" Content="上一步：代理" Click="PluginBackButton_Click"/>
                                            <Button x:Name="PluginFinishButton" Margin="0,0,0,10" Style="{StaticResource PrimaryButton}" Content="完成配置" Click="PluginFinishButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
