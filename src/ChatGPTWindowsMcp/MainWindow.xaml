<Window x:Class="ChatGPTWindowsMcp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Windows MCP"
        Width="920" Height="690"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- 主页面 -->
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,22,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="840" HorizontalAlignment="Stretch">
                    <TextBlock Text="ChatGPT Windows MCP" Style="{StaticResource TitleText}"/>
                    <TextBlock Margin="0,10,0,28"
                               MaxWidth="900"
                               FontSize="16"
                               LineHeight="25"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Windows-MCP + OpenAI Secure MCP Tunnel 的便携启动器。用户完成 OpenAI Tunnel 配置后，即可在 ChatGPT 中通过连接器操作本机。"/>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="720">
                            <TextBlock x:Name="StatusTitleText"
                                       HorizontalAlignment="Center"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="StatusDetailText"
                                       Margin="0,10,0,24"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="PrimaryButton"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="PrimaryButton_Click"/>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="OpenChatGptButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Visibility="Collapsed"
                                        Content="打开 ChatGPT"
                                        Click="OpenChatGptButton_Click"/>
                                <Button x:Name="ReconfigureButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource AccentBrush}"
                                        Padding="8,6"
                                        Visibility="Collapsed"
                                        Content="重新配置"
                                        Click="ReconfigureButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="AdvancedExpander" Margin="0,24,0,0" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="高级选项" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="10,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="通常无需修改"/>
                            </StackPanel>
                        </Expander.Header>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="运行设置" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Margin="0,6,0,24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="这些参数用于本地 Windows-MCP 和 OpenAI Tunnel 的启动过程。默认值适用于大多数用户。"/>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="MCP 本地端口" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PortTextBox"/>
                                    <TextBlock Text="默认 8000。仅在端口冲突或自定义本地 MCP 时修改。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Tunnel Profile" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProfileTextBox"/>
                                    <TextBlock Text="默认 windows-mcp。作为 tunnel-client 的本地配置名称。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Windows-MCP 包" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WindowsMcpTextBox"/>
                                    <TextBlock Text="默认 windows-mcp，也可以填写固定版本。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Python 版本" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PythonTextBox"/>
                                    <TextBlock Text="默认 3.13，由 uv/uvx 提供运行环境。" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,26">
                                    <TextBlock Text="Control Plane 代理" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProxyTextBox"/>
                                    <TextBlock Text="留空时自动检测环境变量和 Windows 系统代理。示例：http://127.0.0.1:7890" Style="{StaticResource HelpText}"/>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" FontSize="18"/>
                                        <CheckBox x:Name="AutoDetectProxyCheckBox" Margin="0,16,0,10" Content="自动读取 Windows 系统代理供 OpenAI Control Plane 使用"/>
                                        <CheckBox x:Name="ReuseMcpCheckBox" Margin="0,0,0,10" Content="本地端口已有 MCP 时复用"/>
                                        <CheckBox x:Name="AutoOpenCheckBox" Margin="0,0,0,10" Content="连接成功后自动打开 ChatGPT 连接器设置"/>
                                        <CheckBox x:Name="AutoDownloadTunnelCheckBox" Margin="0,0,0,0" Content="缺少 tunnel-client 时自动下载官方最新版"/>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,26,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,12,10" Content="保存高级选项" Click="SaveAdvancedButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="连接诊断" Click="DoctorButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="打开日志目录" Click="OpenLogsButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,12,10" Content="打开 config.json" Click="OpenConfigButton_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" Content="打开 ChatGPT 连接器" Click="OpenConnectorButton_Click"/>
                                </WrapPanel>

                                <Border Margin="0,16,0,0" Padding="16" Background="#FFF8E8" CornerRadius="0">
                                    <TextBlock Foreground="#79520A" TextWrapping="Wrap"
                                               Text="安全说明：Windows-MCP 以完整工具模式运行。Runtime API Key 会保存在本机 config.json 中，请勿提交或分享真实配置。"/>
                                </Border>

                                <TextBlock Margin="0,28,0,10" Text="运行日志" Style="{StaticResource SectionTitle}" FontSize="18"/>
                                <TextBox x:Name="LogTextBox"
                                         Height="220"
                                         Padding="12"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="12.5"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 两步配置向导 -->
        <Grid x:Name="WizardRoot" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,22,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Text="创建 MCP 链接" Style="{StaticResource TitleText}"/>

                        <StackPanel Margin="0,12,0,26" Orientation="Horizontal">
                            <TextBlock x:Name="WizardStepCaption" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Margin="18,0,10,0" Padding="12,6" CornerRadius="0" Background="#EAF2FF">
                                <TextBlock x:Name="TunnelStepPill" Text="1  Tunnel ID" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Margin="2,5,2,0" Foreground="#A0A5AD" Text="────────"/>
                            <Border Margin="10,0,0,0" Padding="12,6" CornerRadius="0" Background="#ECEEF1">
                                <TextBlock x:Name="ApiStepPill" Text="2  API Key" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Padding="32">
                            <Grid>
                                <Grid x:Name="TunnelStepPanel">
                                    <StackPanel>
                                        <TextBlock Text="创建 Tunnel" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <TextBlock Margin="0,10,0,22" FontSize="15" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="先创建一个 OpenAI Tunnel，然后把生成的 Tunnel ID 粘贴到下面。"/>
                                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="打开 Tunnel 创建页面" Click="WizardOpenTunnel_Click"/>

                                        <TextBlock Margin="0,28,0,8" Text="Tunnel ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TunnelIdTextBox" TextChanged="TunnelIdTextBox_TextChanged"/>
                                        <TextBlock x:Name="TunnelValidationText" Style="{StaticResource HelpText}"/>

                                        <Grid Margin="0,28,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="取消" Click="WizardCancel_Click"/>
                                            <Button x:Name="TunnelNextButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="下一步" Click="TunnelNextButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ApiStepPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="创建 Runtime API Key" Style="{StaticResource SectionTitle}" FontSize="28"/>
                                        <TextBlock Margin="0,10,0,22" FontSize="15" LineHeight="24" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="创建一个 Runtime API Key，用于让这台电脑连接到刚才配置的 OpenAI Tunnel。"/>
                                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="打开 API Key 创建页面" Click="WizardOpenApiKey_Click"/>

                                        <TextBlock Margin="0,28,0,8" Text="Runtime API Key" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ApiKeyPasswordBox" PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>
                                            <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed" TextChanged="ApiKeyTextBox_TextChanged"/>
                                            <CheckBox x:Name="ShowApiKeyCheckBox" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Content="显示密钥" Checked="ShowApiKeyCheckBox_Changed" Unchecked="ShowApiKeyCheckBox_Changed"/>
                                        </Grid>
                                        <TextBlock x:Name="ApiValidationText" Style="{StaticResource HelpText}"/>

                                        <Grid Margin="0,28,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Content="取消" Click="WizardCancel_Click"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="上一步" Click="WizardBack_Click"/>
                                            <Button x:Name="ApiFinishButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="完成" Click="ApiFinishButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
